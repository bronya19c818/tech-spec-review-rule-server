# 服务端监听（默认只绑本机，不给外部访问）
RULE_SERVER_HOST=127.0.0.1
RULE_SERVER_PORT=8010

# 对外监听（如 0.0.0.0 或局域网 IP）时必填；未填会拒绝启动。
# 客户端设置里的「服务令牌」要填同一个值。
# RULE_SERVER_TOKEN=

# 单次请求体上限（字节），防止超大分块灌库
# RULE_SERVER_MAX_BODY_BYTES=33554432

# 数据目录（默认 ./data，含 pg 与 logs）
# RULE_SERVER_DATA_DIR=D:\path\to\data

# 嵌入模型：索引由服务端建立，客户端不配置这一项。
# 换模型必须同时改 TSR_EMBEDDING_DIMENSIONS，并重建索引（见 README）。
TSR_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
TSR_EMBEDDING_MODEL=BAAI/bge-m3
TSR_EMBEDDING_API_KEY=
TSR_EMBEDDING_DIMENSIONS=1024
