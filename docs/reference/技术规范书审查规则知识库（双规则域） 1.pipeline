    - data:
        code: "import json\n\n\ndef main(\n    document_name: str,\n    rule_domain:\
          \ str,\n    object_scope: str,\n    document_role: str,\n    part: str,\n\
          \    section_number: str,\n    section_title: str,\n    rule_kind: str,\n\
          \    scope_level: str,\n    stage: str,\n    rule_code: str,\n    rule_title:\
          \ str,\n    registry_content: str,\n) -> dict:\n    rule_domain = (rule_domain\
          \ or \"\").strip()\n\n    if rule_domain == \"basic_check\":\n        payload\
          \ = {\n            \"document_name\": document_name,\n            \"document_role\"\
          : document_role,\n            \"scope_level\": scope_level,\n          \
          \  \"object_scope\": object_scope or None,\n            \"stage\": stage,\n\
          \            \"rule_code\": rule_code,\n            \"rule_title\": rule_title,\n\
          \            \"rule_kind\": rule_kind,\n            \"content\": registry_content,\n\
          \            \"source\": \"dify_pipeline\",\n        }\n        publish_url\
          \ = (\n            \"http://host.docker.internal:8010/v1/basic-rules/publish\"\
          \n        )\n    elif rule_domain == \"chapter_review\":\n        payload\
          \ = {\n            \"document_name\": document_name,\n            \"object_scope\"\
          : object_scope,\n            \"document_role\": document_role,\n       \
          \     \"part\": part,\n            \"section_number\": section_number,\n\
          \            \"section_title\": section_title,\n            \"rule_kind\"\
          : rule_kind,\n            \"content\": registry_content,\n            \"\
          source\": \"dify_pipeline\",\n        }\n        publish_url = (\n     \
          \       \"http://host.docker.internal:8010/v1/rules/publish\"\n        )\n\
          \    else:\n        raise ValueError(f\"未知 rule_domain：{rule_domain}\")\n\
          \n    return {\n        \"payload\": json.dumps(payload, ensure_ascii=False),\n\
          \        \"publish_url\": publish_url,\n    }\n"
        code_language: python3
        desc: 按 rule_domain 自动生成章节规则或基础检查规则的 PostgreSQL 发布载荷与目标 URL。
        outputs:
          payload:
            children: null
            type: string
          publish_url:
            children: null
            type: string
        selected: false
        title: 生成 PostgreSQL 双规则域发布载荷
        type: code
        variables:
        - value_selector:
          - clean_rule
          - document_name
          variable: document_name
        - value_selector:
          - clean_rule
          - rule_domain
          variable: rule_domain
        - value_selector:
          - clean_rule
          - object_scope
          variable: object_scope
        - value_selector:
          - clean_rule
          - document_role
          variable: document_role
        - value_selector:
          - clean_rule
          - part
          variable: part
        - value_selector:
          - clean_rule
          - section_number
          variable: section_number
        - value_selector:
          - clean_rule
          - section_title
          variable: section_title
        - value_selector:
          - clean_rule
          - rule_kind
          variable: rule_kind
        - value_selector:
          - clean_rule
          - scope_level
          variable: scope_level
        - value_selector:
          - clean_rule
          - stage
          variable: stage
        - value_selector:
          - clean_rule
          - rule_code
          variable: rule_code
        - value_selector:
          - clean_rule
          - rule_title
          variable: rule_title
        - value_selector:
          - clean_rule
          - registry_content
          variable: registry_content
      height: 111
      id: build_registry_payload
      position:
        x: 230
        y: 260
      positionAbsolute:
        x: 230
        y: 260
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
    - data:
        authorization:
          config: null
          type: no-auth
        body:
          data:
          - id: key-value-rule-registry-payload
            key: ''
            type: text
            value: '{{#build_registry_payload.payload#}}'
          type: json
        desc: 按规则域自动发布到 /v1/rules/publish 或 /v1/basic-rules/publish；同正文由服务端按 Hash
          幂等去重，正文变化自动生成新版本。
        headers: Content-Type:application/json
        method: post
        params: ''
        retry_config:
          max_retries: 2
          retry_enabled: true
          retry_interval: 500
        selected: false
        ssl_verify: true
        timeout:
          max_connect_timeout: 10
          max_read_timeout: 30
          max_write_timeout: 30
        title: 发布到 PostgreSQL Rule Registry（自动路由）
        type: http-request
        url: '{{#build_registry_payload.publish_url#}}'
        variables: []
      height: 199
      id: publish_registry
      position:
        x: 540
        y: 260
      positionAbsolute:
        x: 540
        y: 260
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
    - data:
        code: "import json\n\n\ndef main(status_code, body: str) -> dict:\n    try:\n\
          \        code = int(status_code)\n    except Exception:\n        raise ValueError(f\"\
          Rule Registry 返回了无效 HTTP 状态码：{status_code}\")\n\n    if code < 200 or code\
          \ >= 300:\n        raise ValueError(\n            f\"Rule Registry 发布失败：HTTP\
          \ {code}；响应：{body}\"\n        )\n\n    try:\n        result = json.loads(body\
          \ or \"{}\")\n    except Exception as exc:\n        raise ValueError(\n\
          \            f\"Rule Registry 响应不是合法 JSON：{body}\"\n        ) from exc\n\
          \n    if result.get(\"success\") is not True:\n        raise ValueError(\n\
          \            f\"Rule Registry 未确认发布成功：{body}\"\n        )\n\n    action\
          \ = str(result.get(\"action\") or \"\")\n    if action not in {\"published\"\
          , \"unchanged\"}:\n        raise ValueError(\n            f\"Rule Registry\
          \ 返回未知发布动作：{action}\"\n        )\n\n    return {\n        \"publish_action\"\
          : action,\n        \"rule_id\": str(result.get(\"rule_id\") or \"\"),\n\
          \        \"version\": str(result.get(\"version\") or \"\"),\n    }\n"
        code_language: python3
        desc: 章节规则/基础规则只有 PostgreSQL 发布成功后，才继续 Dify 父子分块与知识库索引。
        outputs:
          publish_action:
            children: null
            type: string
          rule_id:
            children: null
            type: string
          version:
            children: null
            type: string
        selected: false
        title: 校验 Rule Registry 发布结果
        type: code
        variables:
        - value_selector:
          - publish_registry
          - status_code
          variable: status_code
        - value_selector:
          - publish_registry
          - body
          variable: body
      height: 111
      id: validate_registry_publish
      position:
        x: 850
        y: 260
      positionAbsolute:
        x: 850
        y: 260
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
